{
  "bindings": [
    {
      "type": "httpTrigger",
      "name": "req",
      "direction": "in",
      "methods": [
        "get",
        "post",
        "put",
        "delete",
        "patch",
        "head",
        "options"
      ],
      "route": "{*path}",
      "authLevel" : "ANONYMOUS"
    },
    {
      "type": "http",
      "name": "res",
      "direction": "out"
    }
  ]
}